{"cells":[{"cell_type":"markdown","metadata":{"id":"1F3IXxifU04t"},"source":["## Example 1 — Calculating Cosine Similarity Mathematically\n","\n","**Goal:** Calculate the similarity between two numeric vectors in three ways: manually, with NumPy, and with scikit-learn."],"id":"1F3IXxifU04t"},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"lstfBJm3U04u","executionInfo":{"status":"ok","timestamp":1791644504324,"user_tz":-330,"elapsed":14,"user":{"displayName":"Grande Praveen","userId":"02894554520863233064"}},"outputId":"d8f7421e-42ee-46da-c68b-7d554f09e6aa"},"outputs":[{"output_type":"stream","name":"stdout","text":["Vector A: [3, 1, 2]\n","Vector B: [2, 4, 1]\n"]}],"source":["vector_A = [3, 1, 2]\n","vector_B = [2, 4, 1]\n","\n","print(\"Vector A:\", vector_A)\n","print(\"Vector B:\", vector_B)"],"id":"lstfBJm3U04u"},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"n4G_vracU04w","executionInfo":{"status":"ok","timestamp":1791644504348,"user_tz":-330,"elapsed":22,"user":{"displayName":"Grande Praveen","userId":"02894554520863233064"}},"outputId":"95b1e4e5-0a73-4827-f64e-c8c7a06dfcba"},"outputs":[{"output_type":"stream","name":"stdout","text":["Dot Product (A . B): 12\n"]}],"source":["def dot_product(A, B):\n","    total = 0\n","    for a, b in zip(A, B):\n","        total += a * b\n","    return total\n","\n","dp = dot_product(vector_A, vector_B)\n","print(\"Dot Product (A . B):\", dp)"],"id":"n4G_vracU04w"},{"cell_type":"code","source":[],"metadata":{"id":"ca5A1gkKVW1b"},"id":"ca5A1gkKVW1b","execution_count":null,"outputs":[]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"jBvYU949U04x","executionInfo":{"status":"ok","timestamp":1791644504351,"user_tz":-330,"elapsed":13,"user":{"displayName":"Grande Praveen","userId":"02894554520863233064"}},"outputId":"061c8334-6fbb-47ec-b82b-9739a14298ca"},"outputs":[{"output_type":"stream","name":"stdout","text":["Magnitude of A: 3.7417\n","Magnitude of B: 4.5826\n"]}],"source":["import math\n","\n","def magnitude(A):\n","    total = 0\n","    for a in A:\n","        total += a ** 2\n","    return math.sqrt(total)\n","\n","mag_A = magnitude(vector_A)\n","mag_B = magnitude(vector_B)\n","\n","print(\"Magnitude of A:\", round(mag_A, 4))\n","print(\"Magnitude of B:\", round(mag_B, 4))"],"id":"jBvYU949U04x"},{"cell_type":"markdown","metadata":{"id":"RAXI_XLTU04x"},"source":["Cosine similarity formula:\n","\n","\\[\n","\\text{cosine similarity}(A,B)=\\frac{A\\cdot B}{\\|A\\|\\,\\|B\\|}\n","\\]\n","\n","The dot product is 12. The magnitudes are approximately 3.7417 and 4.5826."],"id":"RAXI_XLTU04x"},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Rv4qJ9MxU04y","executionInfo":{"status":"ok","timestamp":1791644504358,"user_tz":-330,"elapsed":11,"user":{"displayName":"Grande Praveen","userId":"02894554520863233064"}},"outputId":"4338684b-859a-4b90-b8f2-d40b608dcde1"},"outputs":[{"output_type":"stream","name":"stdout","text":["Cosine Similarity (Manual Calculation): 0.6999\n"]}],"source":["def cosine_similarity_manual(A, B):\n","    dp = dot_product(A, B)\n","    mag_A = magnitude(A)\n","    mag_B = magnitude(B)\n","    if mag_A == 0 or mag_B == 0:\n","        raise ValueError(\"Cosine similarity is undefined for a zero vector.\")\n","    return dp / (mag_A * mag_B)\n","\n","result_manual = cosine_similarity_manual(vector_A, vector_B)\n","print(\"Cosine Similarity (Manual Calculation):\", round(result_manual, 4))"],"id":"Rv4qJ9MxU04y"},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EMAZ0tf4U04z","executionInfo":{"status":"ok","timestamp":1791644504366,"user_tz":-330,"elapsed":6,"user":{"displayName":"Grande Praveen","userId":"02894554520863233064"}},"outputId":"c42fb282-424d-4968-f8ce-e9461b2f71cb"},"outputs":[{"output_type":"stream","name":"stdout","text":["Cosine Similarity (NumPy): 0.6999\n"]}],"source":["import numpy as np\n","\n","A = np.array(vector_A)\n","B = np.array(vector_B)\n","\n","result_numpy = np.dot(A, B) / (np.linalg.norm(A) * np.linalg.norm(B))\n","print(\"Cosine Similarity (NumPy):\", round(result_numpy, 4))"],"id":"EMAZ0tf4U04z"},{"cell_type":"code","execution_count":null,"metadata":{"id":"snB84KrUU040"},"outputs":[],"source":["!pip -q install scikit-learn"],"id":"snB84KrUU040"},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"nyiBK8cmU041","executionInfo":{"status":"ok","timestamp":1791644507725,"user_tz":-330,"elapsed":16,"user":{"displayName":"Grande Praveen","userId":"02894554520863233064"}},"outputId":"b75b93df-3d77-4056-cd57-6a1f64eb1284"},"outputs":[{"output_type":"stream","name":"stdout","text":["Cosine Similarity (scikit-learn): 0.6999\n","\n","Manual      : 0.699854\n","NumPy       : 0.699854\n","scikit-learn: 0.699854\n","All three methods match!\n"]}],"source":["from sklearn.metrics.pairwise import cosine_similarity\n","\n","A_2d = np.array(vector_A).reshape(1, -1)\n","B_2d = np.array(vector_B).reshape(1, -1)\n","\n","result_sklearn = cosine_similarity(A_2d, B_2d)[0][0]\n","print(\"Cosine Similarity (scikit-learn):\", round(result_sklearn, 4))\n","\n","print(\"\\nManual      :\", round(result_manual, 6))\n","print(\"NumPy       :\", round(result_numpy, 6))\n","print(\"scikit-learn:\", round(result_sklearn, 6))\n","assert round(result_manual, 4) == round(result_numpy, 4) == round(result_sklearn, 4)\n","print(\"All three methods match!\")"],"id":"nyiBK8cmU041"}],"metadata":{"colab":{"provenance":[{"file_id":"1h7wxC9Ipb74nrIt9mNw_bworGzF8DlcU","timestamp":1791644572223}]},"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":5}